    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "İstanbul'da aynı gün e-imza nasıl alırım?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "İmza İstanbul üzerinden online başvuru yapın. Saat 13:00'e kadar onaylanan başvurular aynı gün kuryeyle teslim edilir. 39 ilçeye ücretsiz teslimat."
        }
      },
      {
        "@type": "Question",
        "name": "Ümraniye'de e-imza satan yer var mı?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, İmza İstanbul Ümraniye'ye aynı gün kurye teslimatı yapmaktadır. Online başvuru yapın, kurye imzanızı kapınıza getirsin."
        }
      },
      {
        "@type": "Question",
        "name": "E-imza fiyatları 2026 ne kadar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bireysel e-imza 1 yıllık 850 TL, 2 yıllık 1.450 TL, 3 yıllık 1.950 TL'den başlayan fiyatlarla. Kurye teslimatı ücretsiz. Toplu başvurularda indirim."
        }
      },
      {
        "@type": "Question",
        "name": "Kadıköy'de e-imza nereden alınır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "İmza İstanbul Kadıköy'e aynı gün ücretsiz kurye teslimatı yapar. Online başvuru yapın, kurye imzanızı ofise veya evinize getirsin."
        }
      },
      {
        "@type": "Question",
        "name": "E-imza hangi belgelerde kullanılır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "E-imza SGK, vergi dairesi, noter, e-fatura, e-arşiv, bankacılık işlemleri, sözleşmeler ve tüm resmi belgelerde ıslak imza yerine geçer."
        }
      },
      {
        "@type": "Question",
        "name": "E-imza başvurusu için hangi belgeler gerekli?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bireysel başvuru için sadece TC kimlik kartı yeterli. Kurumsal başvurularda imza sirküleri ve yetki belgesi istenir."
        }
      },
      {
        "@type": "Question",
        "name": "Beşiktaş'a e-imza teslimatı var mı?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, Beşiktaş'a aynı gün ücretsiz kurye teslimatı yapıyoruz. İstanbul'un 39 ilçesine hizmet veriyoruz."
        }
      },
      {
        "@type": "Question",
        "name": "Maltepe'de e-imza nereden alınır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "İmza İstanbul Maltepe'ye aynı gün kurye teslimatı yapar. Online başvuru sonrası kurye imzanızı adresinize teslim eder."
        }
      },
      {
        "@type": "Question",
        "name": "Şişli'de e-imza satan yerler neresi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "İmza İstanbul Şişli'ye aynı gün ücretsiz teslimat yapar. Ofise gitmeden online başvuru ile imzanızı alın."
        }
      },
      {
        "@type": "Question",
        "name": "Pendik'te e-imza nasıl alınır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pendik'e aynı gün kurye teslimatı ile e-imza alabilirsiniz. İmza İstanbul üzerinden online başvuru yapın."
        }
      }
    ]
  },
  
