rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // OG images - public read
    match /og-images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Diğer tüm dosyalar - admin only
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
